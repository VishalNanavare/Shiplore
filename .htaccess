RewriteEngine on
RewriteCond $1 !^(index\.php|resources|robots\.txt)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ public/index.php/$1 [L,QSA]
SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1

Options -Indexes

# --------------------------------------------------------------------------
# Security: block direct access to files that exist on disk at the project root
# --------------------------------------------------------------------------
# The rewrite above only routes to public/index.php when the requested path does
# NOT exist (!-f / !-d). Anything real is served straight off disk, so every
# loose file at the project root was downloadable. Directory-level denies live in
# database/, pma/, s3_storage/, build/, app/, system/, tests/ and writable/.
<FilesMatch "^(composer\.(json|lock)|env|php\.ini|\.user\.ini|preload\.php|spark|\.ftpquota|\.htaccess 1|phpunit\.dist\.xml|README\.md|LICENSE)$">
	<IfModule authz_core_module>
		Require all denied
	</IfModule>
	<IfModule !authz_core_module>
		Deny from all
	</IfModule>
</FilesMatch>

# Dotfiles: .env, .DS_Store, *.swp and friends.
#
# FilesMatch tests the BASENAME only, so this rule does NOT cover a dotted
# DIRECTORY: a request for /.git/config asks for the file `config`, which does not
# start with a dot and therefore sails straight past. The comment here used to claim
# it covered `.git/*`; it never did.
#
# That gap matters more than it looks. The rewrite below sends only non-existent
# paths to public/index.php, so DocumentRoot is the project root and real files are
# served directly — .git/ included. An exposed .git/ hands over the entire repository
# and its full history, which would defeat making the GitHub repo private.
<FilesMatch "^\.">
	<IfModule authz_core_module>
		Require all denied
	</IfModule>
	<IfModule !authz_core_module>
		Deny from all
	</IfModule>
</FilesMatch>

# Dotted DIRECTORIES, which FilesMatch above cannot reach. Matched on the request
# path, so /.git/config, /.git/HEAD and every object under it are refused.
<IfModule mod_rewrite.c>
	RewriteEngine On
	RewriteRule "(^|/)\.(git|svn|hg|bzr|idea|vscode)(/|$)" - [F,L]
</IfModule>
<IfModule !mod_rewrite.c>
	RedirectMatch 404 "(^|/)\.(git|svn|hg|bzr|idea|vscode)(/|$)"
</IfModule>

# Never serve raw data/backup/log files, wherever they end up.
<FilesMatch "\.(sql|sqlite|db|log|bak|old|orig|save|swp|tar|gz|zip)$">
	<IfModule authz_core_module>
		Require all denied
	</IfModule>
	<IfModule !authz_core_module>
		Deny from all
	</IfModule>
</FilesMatch>

<IfModule mod_headers.c>
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(ttf|ttc|otf|eot|woff|woff2|font.css|css)$">
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>
</IfModule>
<FilesMatch "\.(html?|txt|css|js|php|pl)$">
    SetOutputFilter DEFLATE
 </FilesMatch>

# --------------------------------------------------------------------------
# Security headers
# --------------------------------------------------------------------------
# What used to be here, and why it is gone:
#
#   Header set Access-Control-Allow-Origin "*"
#   Header set Access-Control-Allow-Credentials true
#     Wildcard CORS *with credentials*, on every response, set by Apache before
#     PHP ran. It overrode app/Config/Cors.php (allowedOrigins => [],
#     supportsCredentials => false), which is already correctly locked down.
#     CORS is the application's decision — the `cors` filter handles api/*.
#
#   Header always set Content-Security-Policy "frame-ancestors *"
#     This was an anti-protection: a real CSP header explicitly authorising ANY
#     site to frame ANY page, including every admin action. Replaced with 'self'.
#
#   RewriteCond %{REQUEST_METHOD} OPTIONS / RewriteRule ^(.*)$ $1 [R=200,L]
#     Answered every preflight with 200 before CodeIgniter ran, so the app's own
#     CORS filter and auth filters never saw the request.
<IfModule mod_headers.c>
    # Clickjacking: only this origin may frame our pages.
    Header always set Content-Security-Policy "frame-ancestors 'self'"
    Header always set X-Frame-Options "SAMEORIGIN"

    # Stop MIME sniffing — matters for user-uploaded media served from our origin.
    Header always set X-Content-Type-Options "nosniff"

    # Don't leak paths/tokens in the Referer (e.g. password-reset links).
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Drop powerful features we never use.
    Header always set Permissions-Policy "geolocation=(self), camera=(), microphone=(), payment=(), usb=()"

    # Don't advertise the stack.
    Header always unset X-Powered-By
    Header always unset X-Turbo-Charged-By
</IfModule>

# Compress HTML, CSS, JavaScript, Text, XML and fonts
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE application/javascript
AddOutputFilterByType DEFLATE application/rss+xml
AddOutputFilterByType DEFLATE application/vnd.ms-fontobject
AddOutputFilterByType DEFLATE application/x-font
AddOutputFilterByType DEFLATE application/x-font-opentype
AddOutputFilterByType DEFLATE application/x-font-otf
AddOutputFilterByType DEFLATE application/x-font-truetype
AddOutputFilterByType DEFLATE application/x-font-ttf
AddOutputFilterByType DEFLATE application/x-javascript
AddOutputFilterByType DEFLATE application/xhtml+xml
AddOutputFilterByType DEFLATE application/xml
AddOutputFilterByType DEFLATE font/opentype
AddOutputFilterByType DEFLATE font/otf
AddOutputFilterByType DEFLATE font/ttf
AddOutputFilterByType DEFLATE image/svg+xml
AddOutputFilterByType DEFLATE image/x-icon
AddOutputFilterByType DEFLATE text/css
AddOutputFilterByType DEFLATE text/html
AddOutputFilterByType DEFLATE text/javascript
AddOutputFilterByType DEFLATE text/plain
AddOutputFilterByType DEFLATE text/xml
</IfModule>

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php85” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php85 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit

# Neutralise script inside uploaded SVGs.
#
# The brand-logo upload accepts image/svg+xml by design (the form's accept attribute
# advertises it), and an SVG is an XML document that can carry <script>. Served from our
# own origin it would run with our origin's privileges. This CSP makes the file inert on
# direct navigation while leaving <img src="...svg"> embedding completely unaffected.
<FilesMatch "\.svg$">
	<IfModule headers_module>
		Header always set Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; sandbox"
	</IfModule>
</FilesMatch>
