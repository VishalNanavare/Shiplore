/.env
/*.sql
# /vendor/* (not /vendor/) + a narrow re-include below: a bare /vendor/ pattern
# excludes the directory itself, and git will not even look inside an excluded
# directory for a negation match — so vendor/.htaccess (audit M28: the deny file
# that stops GET /vendor/composer/installed.json disclosing the exact pinned
# version of every dependency) could never be un-ignored under the old pattern.
# Do NOT broaden the negation below — that is the one file meant to be tracked
# here; everything else in vendor/ (101 MB of dependencies) stays regenerated by
# `composer install`, never committed.
/vendor/*
!/vendor/.htaccess
/public/uploads/
/writable/uploads/
/writable/cache/*
/writable/logs/*
/writable/session/*
/writable/debugbar/*
.DS_Store
/build/logs/
/build/.phpunit.cache/

# Env files at ANY depth. "/.env" above is root-anchored and never covered the
# nested s3_storage/ application, whose env carried live object-store credentials.
**/.env

# Generated by database/build_run_all.php — rebuild, do not commit.
/database/_full_schema.sql

# ---------------------------------------------------------------------------
# Untracked when this repository was made public.
#
# NOTE, and it is the important part: ignoring a path does NOT remove it from the
# published history. Everything below stayed readable in earlier commits, so any
# credential that ever appeared in one must be treated as disclosed and ROTATED —
# deleting the file is not a remedy. See the demo staff logins in
# database/sql/99b_demo_staff_logins.sql — it shipped a working staff password.
# ---------------------------------------------------------------------------

# Schema, migrations, seeds and import tooling. Carried real seed records, demo
# logins and platform structure. Kept on disk and on the server, out of the repo.
/database/

# Internal security-audit write-ups — a map of this platform's weak points.
/docs/

# A full phpMyAdmin install (4,448 files) that was committed into the app tree.
# Third-party software with its own release channel; never belongs in this repo.
/pma/

# PHP runtime config. Carries cPanel-specific absolute paths (open_basedir,
# session.save_path) that describe the production filesystem layout.
.user.ini
php.ini
**/.user.ini
**/php.ini

# cPanel leftovers. `test_shiplore_in/` is a subdomain docroot whose DIRECTORY NAME is
# the deployment hostname — no content grep finds that, only a filename scan does.
/test_shiplore_in/
.ftpquota
/.htaccess 1

# Real uploaded content of the nested object-store app. A tracked .xlsx here published
# seven live email addresses and ~250 real names inside xl/sharedStrings.xml, plus a
# scanned handwritten signature — none of it findable by a text grep, because the
# payload is zip-compressed inside a binary file.
/s3_storage/writable/data/
/s3_storage/writable/.meta/
