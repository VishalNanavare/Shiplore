# --- Security: deny all web access. ---------------------------------------
# This is a second, separate CodeIgniter application nested inside the web root.
# It ships its own git-tracked .env containing live object-store credentials
# (s3.accessKey / s3.secretKey), shared with the main app's aws_settings. Those
# bytes were retrievable over plain HTTP.
#
# This deny stops the disclosure immediately. The credentials must still be
# ROTATED — assume them compromised.
<IfModule authz_core_module>
	Require all denied
</IfModule>
<IfModule !authz_core_module>
	Deny from all
</IfModule>
# --------------------------------------------------------------------------

# BEGIN cPanel-generated php ini directives, do not edit
# Manual editing of this file may result in unexpected behavior.
# To make changes to this file, use the cPanel MultiPHP INI Editor (Home >> Software >> MultiPHP INI Editor)
# For more information, read our documentation (https://go.cpanel.net/EA4ModifyINI)
<IfModule php8_module>
   php_flag log_errors On
</IfModule>
<IfModule lsapi_module>
   php_flag log_errors On
</IfModule>
# END cPanel-generated php ini directives, do not edit

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php85” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php85 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
