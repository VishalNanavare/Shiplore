
CI_ENVIRONMENT = production

# baseURL is cosmetic for this API server (SigV4 reads the real Host header).
app.baseURL = 'https://s3.shiplore.in/'
app.indexPage = ''

#--------------------------------------------------------------------
# S3 server config (consumed by Config\S3Server)
#--------------------------------------------------------------------
# storagePath = the writable dir; bucket "data" => writable/data/<key>
s3.storagePath = 'writable'
s3.region = 'ap-southeast-1'

# Shared credentials — MUST match the main app's aws_settings (client_key / client_secret)
s3.accessKey = 'AKIA5725L875487986978HUJ9HKJKNPVV57GAZ27'
s3.secretKey = '1y/lhmXbM7VTKEOXzQ9KzjqDt5ewsg56w4uFDSGRg54y5hehgrgrQH6vDzku/vRAjUysf'
s3.enforceSignatureV4 = true

# CORS — allow the main app origin to PUT/GET directly from the browser
s3.enableCors = true
s3.cors.origins = 'https://shiplore.in,https://admin.shiplore.in,https://vendor.shiplore.in,https://shop.shiplore.in,https://rider.shiplore.in'
