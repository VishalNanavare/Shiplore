# Deny all web access.
#
# This directory holds DB maintenance scripts (seed_big.php, seed_images.php,
# apply_sql.php), the SQL schema/seed files under sql/, and shiplore.db. None of
# it is part of the public application surface.
#
# Without this, the root .htaccess serves any file that exists on disk directly
# (RewriteCond %{REQUEST_FILENAME} !-f), so an anonymous GET /database/seed_big.php
# would execute a script that runs mass DELETE statements against production, and
# GET /database/sql/11_seed.sql would disclose the bootstrap super-admin credentials.
#
# The scripts also carry their own CLI-only guard as defence in depth.
<IfModule authz_core_module>
	Require all denied
</IfModule>
<IfModule !authz_core_module>
	Deny from all
</IfModule>
